# ---------------------------------------------------------------------------
# Open City Pulse — environment variables
#
# Every external API used by this project is free and keyless, so the app runs
# with NO environment variables at all. The values below are optional.
# ---------------------------------------------------------------------------

# Public base URL, used for SEO metadata (Open Graph / canonical URLs).
# On Vercel you can leave this unset; the deployment URL is detected instead.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
